    "preset.rename.notUniqueHint": {
      "localizations": {
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Sem Nº sequencial ou Nome original, dois arquivos podem sair com o mesmo nome. Quando isso acontece, o app põe a data e a hora no fim pra não perder nenhum."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Without Sequence no. or Original name, two files can end up with the same name. When that happens, the app adds the date and time at the end so none is lost."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Sin Nº secuencial ni Nombre original, dos archivos pueden quedar con el mismo nombre. Cuando pasa, la app agrega la fecha y la hora al final para no perder ninguno."
          }
        }
      }
    },
