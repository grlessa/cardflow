    "format.settings.explainer": {
      "localizations": {
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "O Cardflow formata o cartão no padrão oficial dos cartões SD, só depois que a cópia fica verde. Pra ativar, o macOS pede duas autorizações uma única vez: permitir o ajudante de formatação e dar a ele Acesso Total ao Disco, que o leitor de SD do Mac exige."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Cardflow formats the card to the official SD card standard, only after the copy turns green. To turn it on, macOS asks for two approvals just once: allow the formatting helper and give it Full Disk Access, which the Mac's SD reader requires."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Cardflow formatea la tarjeta con el estándar oficial de tarjetas SD, solo después de que la copia queda en verde. Para activarlo, macOS pide dos autorizaciones una sola vez: permitir el asistente de formateo y darle Acceso total al disco, que el lector SD del Mac exige."
          }
        }
      }
    },
