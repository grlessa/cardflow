    "error.offload.notEnoughSpace %@": {
      "localizations": {
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Não há espaço suficiente em: %@. Libere espaço no destino e tente de novo."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Not enough space on: %@. Free up space on the destination and try again."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "No hay espacio suficiente en: %@. Libera espacio en el destino e inténtalo de nuevo."
          }
        }
      }
    },
    "error.offload.unsafeDestination": {
      "localizations": {
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Este modelo tem uma estrutura de pastas inválida (tentou gravar fora da pasta de destino). Edite o modelo e tente de novo."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "This template has an invalid folder structure (it tried to write outside the destination folder). Edit the template and try again."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Este modelo tiene una estructura de carpetas inválida (intentó escribir fuera de la carpeta de destino). Edita el modelo e inténtalo de nuevo."
          }
        }
      }
    },
    "error.offload.cancelled": {
      "localizations": {
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Cópia cancelada. Os arquivos já copiados estão no destino, mas a cópia ficou incompleta. Mantenha o cartão como está."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Copy cancelled. The files already copied are at the destination, but the copy is incomplete. Keep the card as is."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Copia cancelada. Los archivos ya copiados están en el destino, pero la copia quedó incompleta. Mantén la tarjeta como está."
          }
        }
      }
    },
    "error.offload.diskFullDuringCopy": {
      "localizations": {
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Um disco de destino encheu durante a cópia. Libere espaço e tente de novo. O cartão continua intacto, mantenha-o como está."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "A destination disk filled up during the copy. Free up space and try again. The card is untouched, keep it as is."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Un disco de destino se llenó durante la copia. Libera espacio e inténtalo de nuevo. La tarjeta sigue intacta, mantenla como está."
          }
        }
      }
    },
    "error.offload.permissionDenied": {
      "localizations": {
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "O macOS bloqueou o acesso à pasta de destino. Libere em Ajustes › Privacidade › Arquivos e Pastas e tente de novo. O cartão está intocado."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "macOS blocked access to the destination folder. Allow it in Settings › Privacy › Files and Folders and try again. The card is untouched."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "macOS bloqueó el acceso a la carpeta de destino. Permítelo en Ajustes › Privacidad › Archivos y carpetas e inténtalo de nuevo. La tarjeta está intacta."
          }
        }
      }
    },
    "error.naming.unknownToken %@": {
      "localizations": {
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "O modelo usa um campo desconhecido: “%@”. Revise a estrutura de pastas ou o padrão de nome."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "The template uses an unknown field: “%@”. Review the folder structure or the naming pattern."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "El modelo usa un campo desconocido: “%@”. Revisa la estructura de carpetas o el patrón de nombre."
          }
        }
      }
    },
    "error.naming.unknownModifier %@": {
      "localizations": {
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "O modelo usa um modificador desconhecido: “%@”."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "The template uses an unknown modifier: “%@”."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
