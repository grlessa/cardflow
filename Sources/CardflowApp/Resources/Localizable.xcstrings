    "format.activation.diskAccessHelp": {
      "localizations": {
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Sem essa permissão, o macOS bloqueia a formatação no leitor de cartão do Mac. Abra o painel, clique em + e adicione o ajudante do Cardflow. Só precisa fazer isso uma vez."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Without it, macOS blocks formatting in the Mac's card reader. Open the panel, click + and add the Cardflow helper. You only do this once."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Sin esto, macOS bloquea el formateo en el lector de tarjetas del Mac. Abre el panel, haz clic en + y agrega el ayudante de Cardflow. Solo se hace una vez."
          }
        }
      }
    },
