          }
        }
      }
    },
    "error.naming.pathTraversal": {
      "localizations": {
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "A estrutura de pastas do modelo é inválida: ela sairia da pasta de destino."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "The template’s folder structure is invalid: it would leave the destination folder."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
